<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.josie.tripstar.mapper.UserMapper">
    <insert id="insertIfAbsent">
        INSERT INTO app_user(public_id) VALUES(#{publicId}) ON DUPLICATE KEY UPDATE public_id = public_id
    </insert>
    <select id="find" resultType="AppUser">SELECT * FROM app_user WHERE public_id = #{publicId}</select>
</mapper>
